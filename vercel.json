{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "functions": {
    "api/handler.js": {
      "maxDuration": 30,
      "includeFiles": "server/**",
      "regions": ["sin1"]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/handler?path=$1" }
  ]
}
