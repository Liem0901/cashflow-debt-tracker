# MongoDB Atlas — cloud storage for signed-in users
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cashflow?retryWrites=true&w=majority

# Firebase — client (Vite exposes VITE_* to the browser)
# Copy to .env.local for local Google sign-in (Firebase Console → Project settings → Web app)
# Enable Authentication → Sign-in method → Google. localhost is allowed by default.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local dev: Google auth + localStorage only (no MongoDB). Default when running npm run dev.
VITE_LOCAL_ONLY=true

# Optional — skip login screen entirely (no Google, no guest prompt)
# VITE_AUTH_BYPASS=true

# Firebase — server (verifies Google sign-in tokens on /api/data)
# Option A: paste full service account JSON as one line (or use Option B in .env.local)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id",...}

# Option B: separate fields from service account JSON
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Fallback user id when Firebase auth is not configured on the server (dev only)
DEFAULT_USER_ID=default-user

# Optional — override API base URL (defaults to same origin)
# VITE_API_BASE_URL=

# Admin panel — comma-separated allowlist (must match server-side ADMIN_* values)
ADMIN_EMAILS=you@example.com
ADMIN_UIDS=
VITE_ADMIN_EMAILS=you@example.com
VITE_ADMIN_UIDS=
