# Copy to .env for local development (do not commit .env)
# Production/Preview secrets go in the Vercel dashboard — not in a file.

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cashflow?retryWrites=true&w=majority
DEFAULT_USER_ID=default-user

# Firebase — client (Vite exposes VITE_* to the browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local: skip login (true) or require email/Google (false)
VITE_AUTH_BYPASS=false

# Local: localStorage only (true) or sync via /api + MongoDB (false; needs npm run dev:full)
VITE_LOCAL_ONLY=false

# Firebase — server (verifies Google tokens on /api)
# Option A: full service account JSON as one line
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id",...}

# Option B: separate fields
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional — override API base URL (defaults to same origin)
# VITE_API_BASE_URL=

# Vite dev only: proxy /api → this URL (when using npm run dev alongside dev:full)
# VITE_DEV_API_URL=http://127.0.0.1:3005

# Admin allowlist (must match on client + server)
ADMIN_EMAILS=you@example.com
ADMIN_UIDS=
VITE_ADMIN_EMAILS=you@example.com
VITE_ADMIN_UIDS=

# Gemini AI (server only — get a free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
AI_MODEL=gemini-2.0-flash

# Deploy notes:
# - Only api/handler.js under api/ (Hobby ≤12 serverless functions). Shared code in server/.
# - Set production secrets in Vercel → Settings → Environment Variables.
